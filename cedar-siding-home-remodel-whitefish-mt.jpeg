        <img src="../assets/Kalkman-Construction.webp" alt="Kalkman Construction — Whitefish, MT" style="height:58px;width:auto">
      </a>
      <nav style="display:flex;gap:20px;margin-left:auto;font-family:Archivo,Helvetica,sans-serif;font-size:14px;font-weight:600;align-items:center;white-space:nowrap;flex-wrap:wrap">
        <a href="../" class="nav-link" style="color:#3a3d35">Home</a>
