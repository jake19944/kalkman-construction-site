<body>
<div>

  <div style="background:#14331d;color:#e8ead9;font-family:Archivo,Helvetica,sans-serif;font-size:13px;letter-spacing:0.04em">
    <div class="wrap" style="padding-top:9px;padding-bottom:9px;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
