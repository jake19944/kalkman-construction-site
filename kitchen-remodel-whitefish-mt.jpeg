  .cap { position:absolute; left:0; right:0; bottom:0; padding:36px 14px 12px; background:linear-gradient(transparent,rgba(12,32,19,0.82)); color:#f4f2e9; font-family:Archivo,Helvetica,sans-serif; font-size:13.5px; font-weight:600; text-align:left; display:block; }
  .grid4 { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
